# Generated by Cargo
# will have compiled files and executables
/target/
pkg

# These are backup files generated by rustfmt
**/*.rs.bk

# node e2e test tools and outputs
node_modules/
test-results/
end2end/playwright-report/
playwright/.cache/

.idea
.DS_Store

# Scratch log from local `docker build` validation runs
.docker-build.log

# Never commit local secrets/credentials
.env
.env.*
*.pem
*.key

/end2end/*.js
/end2end/*.js.map
/end2end/tests/*.js
/end2end/tests/*.js.map
